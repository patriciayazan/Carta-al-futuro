<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Estilo para títulos principales en serif con tono dorado brillante -->
    <style name="TextAppearance.DarkAcademia.Titulo" parent="android:TextAppearance">
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">30sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/color_dorado_brillante</item>
        <item name="android:letterSpacing">0.04</item>
    </style>

    <!-- Estilo para subtítulos y citas reflexivas en tono crema pergamino -->
    <style name="TextAppearance.DarkAcademia.Subtitulo" parent="android:TextAppearance">
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/color_texto_secundario</item>
        <item name="android:lineSpacingExtra">5dp</item>
    </style>

    <!-- Estilo para leyendas y notas de pie (estilo grabado antiguo) -->
    <style name="TextAppearance.DarkAcademia.Leyenda" parent="android:TextAppearance">
        <item name="android:fontFamily">serif</item>
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/color_texto_secundario</item>
        <item name="android:letterSpacing">0.12</item>
    </style>

    <!-- Botón primario: Acabado dorado con texto oscuro de alto contraste -->
    <style name="Widget.DarkAcademia.BotonDorado" parent="android:Widget.Button">
        <item name="android:background">@drawable/bg_boton_dorado</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/color_fondo</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:elevation">2dp</item>
    </style>

    <!-- Botón secundario: Superficie oscura con borde dorado -->
    <style name="Widget.DarkAcademia.BotonSecundario" parent="android:Widget.Button">
        <item name="android:background">@drawable/bg_boton_secundario_dorado</item>
        <item name="android:fontFamily">serif</item>
        <item name="android:textColor">@color/color_dorado</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:elevation">0dp</item>
    </style>

</resources>
